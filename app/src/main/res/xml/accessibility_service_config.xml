<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped deliberately narrow: only window-state events, only enough to read
  the foreground package name. canRetrieveWindowContent is NOT enabled —
  we don't read screen text/content, which would cross into keylogging
  territory and is out of scope (see Modo B section of the design doc).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/accessibility_service_description" />
